# 复制成 server/.env（同名，不带 .example）再改值；.env 已在 .gitignore 里，不会入库
# PM2 重启后生效：pm2 restart wenyazw-back --update-env

# 中转站（站内免费模型）
RELAY_BASE=https://aiaiai.ruinet.work
RELAY_PATH=/v1/chat/completions
RELAY_KEY=

# 模型回退链，顺序即优先级，逗号分隔；第一个是最想用的
# 默认：deepseek-v4.1-flash,deepseek-v4-flash,kimi-k3.1-pro,qwen3.8-flash,glm-4.6,mimo-v2.6-pro,minimax-m3.1-flash,gemini-3.5-flash,gpt-4o-mini
SITE_MODELS=

# 积分
SIGNUP_CREDITS=15
COST_PER_CALL=1

# 管理接口 token（给账号补积分用；不配则管理接口直接 403）
ADMIN_TOKEN=

# 注册风控
REG_IP_DAILY_CODES=5
REG_DAILY_TOTAL=50

# 模型失败后冷冻多久再试（毫秒），默认 3 分钟
MODEL_COOLDOWN_MS=180000

# 站内模型限速
LLM_PER_MIN_USER=12
LLM_PER_MIN_IP=20
LLM_DAILY_USER=200
